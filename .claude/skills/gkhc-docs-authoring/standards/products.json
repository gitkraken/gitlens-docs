        {
          "pattern": "kepler://settings",
          "why": "no UI creates or copies a settings link; say that clicking a setting Ask Kepler names opens it in Settings"
        },
        {
          "pattern": "kepler://session\\?",
          "why": "the agent=/id= session link has no UI producer; Copy session link gives kepler://session/<id>"
        },
        {
          "pattern": "@id:",
          "why": "no UI shows a setting id, so users cannot search by one; describe search by name"
        },
        {
          "pattern": "/settings/[a-z-]+#|#setting-[A-Za-z0-9_-]+\\.",
          "why": "Settings hash routes and anchors (setting-<id>, ids hold a dot) are internal navigation; docs heading anchors such as #setting-an-actions-agent are not"
        },
        {
          "pattern": "[?&]host=",
          "why": "an internal link parameter; say that a link copied on a remote machine opens on that machine"
        },
        {
          "pattern": "\\bOSC 7501\\b",
          "why": "a terminal protocol detail; say that some terminal programs report their own status"
        }
      ]
